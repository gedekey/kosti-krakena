class_name CampaignBalance
extends RefCounted
## Числа кампании (DESIGN.md §8г). Единственное место, где они заданы.

## Уровней в кампании.
const LEVEL_COUNT := 6

## В матчах кампании Palifico и Calza всегда включены (настройки не влияют).
const PALIFICO := true
const CALZA := true

# --- «Дурной глаз» (ур. 3) ---
