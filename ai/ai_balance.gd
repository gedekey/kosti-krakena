class_name AiBalance
extends RefCounted
## Числа модели ИИ жульничества и обвинений (М6). Единственное место, где они заданы.
## Характерные параметры (насколько бот жулик, порог обвинения…) — в BotPersonality.

# --- Обвинения -----------------------------------------------------------------

## Априорная вера, что соперник жульничает в раунде (до улик этого раунда).
const CHEAT_PRIOR := 0.25
## Насколько «лишняя» улика прошлых раундов (сверх ожидаемых ложных) поднимает априор.
const PRIOR_PER_EXCESS_EVIDENCE := 0.12
## Границы априора с учётом памяти.
const PRIOR_MIN := 0.05
const PRIOR_MAX := 0.6
## Как бот моделирует жулика: шанс улики за действие (истинная или ложная).
const CHEATER_EVIDENCE_RATE := 0.5

# --- Трюки ---------------------------------------------------------------------

## Каждая своя улика в раунде умножает желание жульничать ещё на это значение.
const OWN_EVIDENCE_CAUTION := 0.5
## Больше стольких кубиков в рукаве за раунд бот не берёт.
const MAX_SLEEVE_PER_ROUND := 1
## Трюки-разведка («Подглядеть», «Шёпот Бездны») на текущую ставку — только если вера
## в неё в этих пределах (иначе решение и так очевидно, рисковать незачем).
const INFO_DOUBT_MIN := 0.2
const INFO_DOUBT_MAX := 0.8
## «Толкнуть чашку» поставившего — только если бот и так склоняется к «Лжи!».
const NUDGE_BELIEF_MAX := 0.5
## Улика от трюка покажется при этом действии: «Ложь!» закончит раунд раньше, чем
## кто-то успеет обвинить, — порог «Лжи!» поднимается на столько.
const EXPOSED_DUDO_BIAS := 0.15
