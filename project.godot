; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Кости Кракена"
config/name_localized={
"en": "Kraken's Dice",
"ru": "Кости Кракена"
}
config/version="1.0.0"
run/main_scene="res://scenes/main_menu.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.png"

[audio]

buses/default_bus_layout="res://audio/default_bus_layout.tres"

[autoload]

Events="*res://autoload/events.gd"
Rng="*res://autoload/rng.gd"
Settings="*res://autoload/settings.gd"
Stats="*res://autoload/stats.gd"
Achievements="*res://autoload/achievements.gd"
Ranks="*res://autoload/ranks.gd"
Campaign="*res://autoload/campaign.gd"
Sound="*res://autoload/sound.gd"
TermTips="*res://autoload/term_tips.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"
window/handheld/orientation=4

[dotnet]

project/assembly_name="Кости Кракена"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[gui]

theme/custom="res://ui/theme/kraken_theme.tres"

[internationalization]

locale/translations=PackedStringArray("res://i18n/strings.en.translation", "res://i18n/strings.ru.translation", "res://i18n/barks.en.translation", "res://i18n/barks.ru.translation", "res://i18n/campaign.en.translation", "res://i18n/campaign.ru.translation")

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.0509804, 0.0431373, 0.0784314, 1)
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
